<project
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>de.christianmahnke.iiif.fliiifenleger</groupId>
    <artifactId>fliiifenleger-parent</artifactId>
    <version>0.3.2</version>
    <packaging>pom</packaging>
    <name>Fliiifenleger</name>
    <description>A experimental Java-based static IIIF tiler.</description>
    <url>https://github.com/cmahnke/fliiifenleger</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>6.1.3</junit.version>
        <picocli.version>4.7.7</picocli.version>
        <!--
            GraalVM polyglot version for the native profile's explicit
            GraalWasm dependencies (cli/pom.xml).  Keep in sync with the
            graalvm.version property in wasm-runtime/pom.xml.
        -->
        <graalvm.version>25.3.4.1</graalvm.version>
        <auto-service.version>1.1.1</auto-service.version>
        <lombok.version>1.18.48</lombok.version>
        <jackson.version>3.2.2</jackson.version>
        <!-- Silences JEP 471 sun.misc.Unsafe warnings from Lombok's annotation
             processor in forked test JVMs (the Maven JVM itself is covered by
             .mvn/jvm.config). Only exists on JDK 23+, hence requireJavaVersion. -->
        <unsafe.memory.access.arg>--sun-misc-unsafe-memory-access=allow</unsafe.memory.access.arg>
    </properties>

    <modules>
        <module>core</module>
        <module>wasm-runtime</module>
        <module>cli</module>
        <module>jc2pa</module>
        <module>ultrahdr</module>
        <!-- jxl-wasm is NOT built by default (see the native profile below). -->
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Project Modules -->
            <dependency>
                <groupId>de.christianmahnke.iiif.fliiifenleger</groupId>
                <artifactId>core</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Testing -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-api</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-params</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>com.github.tomakehurst</groupId>
                <artifactId>wiremock-jupiter-test</artifactId>
                <version>1.3.6</version>
                <scope>test</scope>
            </dependency>

            <!-- Compile-time -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>com.google.auto.service</groupId>
                <artifactId>auto-service-annotations</artifactId>
                <version>${auto-service.version}</version>
                <scope>provided</scope>
            </dependency>

            <!-- JSON -->
            <dependency>
                <groupId>tools.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>tools.jackson.dataformat</groupId>
                <artifactId>jackson-dataformat-yaml</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <!--
            <dependency>
                <groupId>tools.jackson.core</groupId>
                <artifactId>jackson-core</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            -->
            <dependency>
                <groupId>com.apicatalog</groupId>
                <artifactId>titanium-json-ld</artifactId>
                <version>1.7.0</version>
            </dependency>
            <dependency>
                <groupId>com.networknt</groupId>
                <artifactId>json-schema-validator</artifactId>
                <version>3.0.7</version>
            </dependency>

            <!-- Image IO -->
            <dependency>
                <groupId>com.github.gotson.nightmonkeys</groupId>
                <artifactId>imageio-jxl</artifactId>
                <version>1.1.0</version>
            </dependency>
            <dependency>
                <groupId>com.drewnoakes</groupId>
                <artifactId>metadata-extractor</artifactId>
                <version>2.21.0</version>
            </dependency>

            <!-- Logging -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>2.0.19</version>
            </dependency>
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-classic</artifactId>
                <version>1.6.3</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.6.0</version>
                    <configuration>
                        <!-- The JXL imageio plugin uses the FFM API (Panama);
                             without this flag JDK 24+ warns on every load. -->
                        <argLine>--enable-native-access=ALL-UNNAMED ${unsafe.memory.access.arg} -Djava.awt.headless=true</argLine>
                        <!-- All image tests must run headless (CI has no display);
                             set here so every module fork inherits it. -->
                        <systemPropertyVariables>
                            <java.awt.headless>true</java.awt.headless>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.16.0</version>
                    <configuration>
                        <release>21</release>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>com.google.auto.service</groupId>
                                <artifactId>auto-service</artifactId>
                                <version>${auto-service.version}</version>
                            </path>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <!--
                                picocli-codegen emits GraalVM reflect/resource
                                config for @Command classes into
                                target/classes/META-INF/native-image (consumed
                                by native-image builds; inert JSON otherwise).
                            -->
                            <path>
                                <groupId>info.picocli</groupId>
                                <artifactId>picocli-codegen</artifactId>
                                <version>${picocli.version}</version>
                            </path>
                        </annotationProcessorPaths>
                        <compilerArgs>
                            <arg>-Xlint:deprecation</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-site-plugin</artifactId>
                    <version>3.22.0</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.apache.maven.doxia</groupId>
                            <artifactId>doxia-module-markdown</artifactId>
                            <version>2.1.0</version>
                        </dependency>
                    </dependencies>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!--
                Keeps the site index in sync with README.md: the site renderer
                scans src/site/markdown AND target/generated-site/markdown, so
                the README is copied into the generated site directory at
                pre-site time (no static copy that can drift).  Parent only —
                module sub-sites have no README.
            -->
            <plugin>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>sync-readme-to-site</id>
                        <phase>pre-site</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/generated-site/markdown" />
                                <!-- Renamed: the renderer only treats
                                     index.md as the site's index page. -->
                                <copy file="${project.basedir}/README.md"
                                      tofile="${project.build.directory}/generated-site/markdown/index.md" />
                            </target>
                        </configuration>
                        <inherited>false</inherited>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-project-info-reports-plugin</artifactId>
                <version>3.9.0</version>
            </plugin>
            <!--
                .mvn/jvm.config passes the allow value for
                sun-misc-unsafe-memory-access to silence JEP 471 Unsafe
                warnings from Lombok. That JVM option only exists on JDK 23+,
                so fail fast with an explanation instead of an obscure JVM
                launch error. (Bytecode output stays release 21.)
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>enforce-java</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[23,)</version>
                                    <message>fliiifenleger requires JDK 23+ to build: .mvn/jvm.config uses --sun-misc-unsafe-memory-access=allow (silences sun.misc.Unsafe warnings from Lombok, JEP 471), which does not exist on older JDKs.</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!--
            Native-build-only modules, enabled explicitly with -Pnative.
            jxl-wasm (pure-Rust jxl-oxide decoder as WASM) is reserved for
            the future GraalVM-native build: too slow under Chicory for
            regular JVM use, so it stays out of the default reactor.
        -->
        <profile>
            <id>native</id>
            <modules>
                <module>jxl-wasm</module>
            </modules>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <version>3.6.3</version>
                        <executions>
                            <execution>
                                <id>enforce-graalvm</id>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <!--
                                            The native-image builder ships with GraalVM;
                                            stock JDKs have no bin/native-image.  This
                                            deliberately checks the file (not version
                                            strings): modern GraalVMs no longer set
                                            org.graalvm.version, and Oracle's
                                            java.version (e.g. 25.0.4.1) does not
                                            reveal the GraalVM release.
                                            NOTE: bin/native-image is a symlink into
                                            lib/svm, and requireFilesExist compares
                                            canonical paths (symlinks never match) —
                                            hence the check targets the canonical
                                            target, stable since GraalVM 21.
                                        -->
                                        <requireFilesExist>
                                            <message>Native builds require a GraalVM JDK (no native-image builder under ${java.home}). Set JAVA_HOME to GraalVM 25.3+ to match the pinned polyglot 25.3.x artifacts — mixing builder and polyglot versions fails the image build.</message>
                                            <files>
                                                <file>${java.home}/lib/svm/bin/native-image</file>
                                            </files>
                                        </requireFilesExist>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
