{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://christianmahnke.de/iiif/schema/hdr-service.json",
  "title": "HDR service extension for IIIF Image API 3.0 info.json",
  "description": "Constrains only service entries claiming the HDR profile; all other entries pass vacuously. Composed with the base schema via allOf (see ServiceExtension).",
  "type": "object",
  "properties": {
    "service": {
      "type": "array",
      "items": {
        "if": {
          "type": "object",
          "required": ["profile"],
          "properties": {
            "profile": { "const": "https://christianmahnke.de/iiif/hdr/" }
          }
        },
        "then": { "$ref": "#/$defs/hdrService" }
      }
    }
  },
  "$defs": {
    "hdrService": {
      "type": "object",
      "required": ["id", "type", "profile"],
      "properties": {
        "id": { "type": "string", "format": "uri" },
        "type": { "type": "string" },
        "profile": { "const": "https://christianmahnke.de/iiif/hdr/" }
      },
      "additionalProperties": true
    }
  }
}
