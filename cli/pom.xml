<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>de.christianmahnke.iiif.fliiifenleger</groupId>
        <artifactId>fliiifenleger-parent</artifactId>
        <version>0.3.2</version>
    </parent>

    <artifactId>cli</artifactId>
    <name>Fliiifenleger :: CLI</name>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>de.christianmahnke.iiif.fliiifenleger</groupId>
            <artifactId>core</artifactId>
        </dependency>
        <dependency>
            <groupId>de.christianmahnke.iiif.fliiifenleger</groupId>
            <artifactId>jc2pa</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>de.christianmahnke.iiif.fliiifenleger</groupId>
            <artifactId>ultrahdr</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- CLI -->
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>${picocli.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>

        <!-- Test scope -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.7</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock</artifactId>
            <version>4.0.0-beta.38</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
            Activated together with the root `native` profile (`mvn -Pnative`):
            swaps the JXL implementation and builds a native binary.
        -->
        <profile>
            <id>native</id>
            <dependencies>
                <!--
                    Drop the FFM-based NightMonkeys JXL plugin (native
                    libraries cannot ship in the image) and use the
                    WASM-based decoder instead.  The exclusion merges with
                    the base `core` dependency above; exactly one "jxl"
                    ImageSource remains registered.
                -->
                <dependency>
                    <groupId>de.christianmahnke.iiif.fliiifenleger</groupId>
                    <artifactId>core</artifactId>
                    <exclusions>
                        <exclusion>
                            <groupId>com.github.gotson.nightmonkeys</groupId>
                            <artifactId>imageio-jxl</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
                <dependency>
                    <groupId>de.christianmahnke.iiif.fliiifenleger</groupId>
                    <artifactId>jxl-wasm</artifactId>
                    <version>${project.version}</version>
                    <exclusions>
                        <exclusion>
                            <groupId>com.dylibso.chicory</groupId>
                            <artifactId>runtime</artifactId>
                        </exclusion>
                        <exclusion>
                            <groupId>com.dylibso.chicory</groupId>
                            <artifactId>wasi</artifactId>
                        </exclusion>
                        <exclusion>
                            <groupId>com.dylibso.chicory</groupId>
                            <artifactId>annotations</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
                <!--
                    The Chicory interpreter is never used inside the image
                    (the engine defaults to GraalWasm there, and WasmEngine
                    reaches Chicory only reflectively so the analysis cannot
                    see it).  Exclude its jars from jc2pa/ultrahdr as well —
                    keeping them would ship megabytes of dead interpreter.
                -->
                <dependency>
                    <groupId>de.christianmahnke.iiif.fliiifenleger</groupId>
                    <artifactId>jc2pa</artifactId>
                    <version>${project.version}</version>
                    <exclusions>
                        <exclusion>
                            <groupId>com.dylibso.chicory</groupId>
                            <artifactId>runtime</artifactId>
                        </exclusion>
                        <exclusion>
                            <groupId>com.dylibso.chicory</groupId>
                            <artifactId>wasi</artifactId>
                        </exclusion>
                        <exclusion>
                            <groupId>com.dylibso.chicory</groupId>
                            <artifactId>annotations</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
                <dependency>
                    <groupId>de.christianmahnke.iiif.fliiifenleger</groupId>
                    <artifactId>ultrahdr</artifactId>
                    <version>${project.version}</version>
                    <exclusions>
                        <exclusion>
                            <groupId>com.dylibso.chicory</groupId>
                            <artifactId>runtime</artifactId>
                        </exclusion>
                        <exclusion>
                            <groupId>com.dylibso.chicory</groupId>
                            <artifactId>wasi</artifactId>
                        </exclusion>
                        <exclusion>
                            <groupId>com.dylibso.chicory</groupId>
                            <artifactId>annotations</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
                <!--
                    GraalWasm engine artifacts.  wasm-runtime declares these
                    optional, so they are NOT inherited transitively and must
                    be listed here explicitly — otherwise polyglotOnClasspath
                    fails and no GraalWasm engine can load.  wasm-community
                    (pom) pulls wasm-language + truffle-runtime.
                -->
                <dependency>
                    <groupId>org.graalvm.polyglot</groupId>
                    <artifactId>polyglot</artifactId>
                    <version>${graalvm.version}</version>
                </dependency>
                <dependency>
                    <groupId>org.graalvm.polyglot</groupId>
                    <artifactId>wasm-community</artifactId>
                    <version>${graalvm.version}</version>
                    <type>pom</type>
                </dependency>
                <!--
                    picocli annotation processor: generates GraalVM
                    reflect/resource config for the CLI commands into
                    target/classes/META-INF/native-image (picked up
                    automatically at image build time).
                -->
                <dependency>
                    <groupId>info.picocli</groupId>
                    <artifactId>picocli-codegen</artifactId>
                    <version>${picocli.version}</version>
                    <scope>provided</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>0.10.6</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <imageName>fliiifenleger</imageName>
                            <mainClass>de.christianmahnke.iiif.fliiifenleger.cli.Main</mainClass>
                            <buildArgs>
                                <buildArg>--no-fallback</buildArg>
                                <!-- `validate` fetches remote info.json over HTTPS. -->
                                <buildArg>--enable-https</buildArg>
                                <!-- Build-time headless init; the runtime default
                                     comes from Main.main (a -D build flag does not
                                     propagate to runtime system properties). -->
                                <buildArg>-Djava.awt.headless=true</buildArg>
                                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <plugins>
            <!-- Generates version.properties (read by the CLI -V option)
                 from the project version. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>generate-version-properties</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>src/main/templates</directory>
                                    <filtering>true</filtering>
                                    <includes>
                                        <include>version.properties</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>de.christianmahnke.iiif.fliiifenleger.cli.Main</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                                <transformer
                                    implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>de.christianmahnke.iiif.fliiifenleger.cli.Main</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <exclude>META-INF/LICENSE</exclude>
                                        <exclude>META-INF/LICENSE.txt</exclude>
                                        <exclude>META-INF/NOTICE</exclude>
                                        <exclude>META-INF/NOTICE.txt</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <!--
                                minimizeJar must stay off: it strips
                                ServiceLoader providers (twelvemonkeys
                                imageio plugins, ImageSource/TileSink
                                implementations) that are only referenced
                                through META-INF/services.
                            -->
                            <finalName>fliiifenleger-cli</finalName>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>