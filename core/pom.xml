<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>de.christianmahnke.iiif.fliiifenleger</groupId>
        <artifactId>fliiifenleger-parent</artifactId>
        <version>0.4.3-SNAPSHOT</version>
    </parent>

    <artifactId>core</artifactId>
    <name>Fliiifenleger :: Core</name>
    <packaging>jar</packaging>
    <properties>
        <jackson.version>3.2.4</jackson.version>
    </properties>

    <dependencies>
        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock</artifactId>
            <version>4.0.0-beta.41</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-junit5</artifactId>
            <version>4.0.0-beta.41</version>
            <scope>test</scope>
        </dependency>

        <!-- Compile-time -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.auto.service</groupId>
            <artifactId>auto-service-annotations</artifactId>
        </dependency>

        <!-- JSON -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
       <dependency>
            <groupId>tools.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
            <version>${jackson.version}</version>
        </dependency>  
        <dependency>
            <groupId>com.apicatalog</groupId>
            <artifactId>titanium-json-ld</artifactId>
        </dependency>
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
        </dependency>

        <!-- Image IO -->
        <dependency>
            <groupId>com.github.gotson.nightmonkeys</groupId>
            <artifactId>imageio-jxl</artifactId>
        </dependency>
        <dependency>
            <groupId>com.drewnoakes</groupId>
            <artifactId>metadata-extractor</artifactId>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>

    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.build.directory}/generated-resources</directory>
            </resource>
        </resources>
        <plugins>
            <!--
                The IIIF Presentation schemas are a moving target (V4 is a
                release candidate), so they are fetched from upstream `main`
                at build time instead of being vendored in the repository.
                Antrun downloads the source tarball, extracts the schema set
                into target/generated-resources, and normalizes four $refs
                whose casing differs from the filenames upstream.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>fetch-presentation-schemas</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <property name="iiif.schema.archive"
                                          value="${project.build.directory}/iiif-presentation-schema.tar.gz" />
                                <property name="iiif.schema.unpack"
                                          value="${project.build.directory}/iiif-schema-upstream" />
                                <property name="iiif.schema.output"
                                          value="${project.build.directory}/generated-resources/schema/presentation" />
                                <get src="https://codeload.github.com/IIIF/presentation-validator/tar.gz/refs/heads/main"
                                     dest="${iiif.schema.archive}"
                                     skipexisting="false" />
                                <delete dir="${iiif.schema.unpack}" />
                                <mkdir dir="${iiif.schema.unpack}" />
                                <untar src="${iiif.schema.archive}"
                                       dest="${iiif.schema.unpack}"
                                       compression="gzip" />
                                <delete dir="${iiif.schema.output}" />
                                <copy todir="${iiif.schema.output}">
                                    <fileset dir="${iiif.schema.unpack}/presentation-validator-main/schema">
                                        <include name="iiif_3_0.json" />
                                        <include name="v4/*.json" />
                                    </fileset>
                                </copy>
                                <replace dir="${iiif.schema.output}/v4" includes="*.json" summary="true">
                                    <replacefilter token="&quot;$ref&quot;: &quot;Metadata.json&quot;"
                                                   value="&quot;$ref&quot;: &quot;metadata.json&quot;" />
                                    <replacefilter token="&quot;$ref&quot;: &quot;Service.json&quot;"
                                                   value="&quot;$ref&quot;: &quot;service.json&quot;" />
                                    <replacefilter token="&quot;$ref&quot;: &quot;Agent.json&quot;"
                                                   value="&quot;$ref&quot;: &quot;agent.json&quot;" />
                                    <replacefilter token="&quot;$ref&quot;: &quot;Audiance.json&quot;"
                                                   value="&quot;$ref&quot;: &quot;audiance.json&quot;" />
                                </replace>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <property>
                            <name>org.slf4j.simpleLogger.defaultLogLevel</name>
                            <value>trace</value>
                        </property>
                    </systemPropertyVariables>
                    <!-- java.awt.headless comes from the parent pom for all modules. -->
                    <argLine>
                        --enable-native-access=ALL-UNNAMED
                        ${unsafe.memory.access.arg}
                        -Djava.awt.headless=true
                    </argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>