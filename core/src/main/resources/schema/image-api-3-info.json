{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://christianmahnke.de/iiif/schema/image-api-3-info.json",
  "title": "IIIF Image API 3.0 info.json (fliiifenleger base schema)",
  "description": "Extension service entries (e.g. C2PA, HDR) are validated as generic services here; their strict schemas are contributed per-module and composed via allOf (see ServiceExtension).",
  "type": "object",
  "required": ["@context", "id", "type", "protocol", "profile", "width", "height"],
  "properties": {
    "@context": {
      "description": "IIIF context last; extension contexts (e.g. C2PA/HDR) prepended.",
      "anyOf": [
        { "const": "http://iiif.io/api/image/3/context.json" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "format": "uri" },
          "contains": { "const": "http://iiif.io/api/image/3/context.json" }
        }
      ]
    },
    "id": { "type": "string", "format": "uri" },
    "type": { "const": "ImageService3" },
    "protocol": { "const": "http://iiif.io/api/image" },
    "profile": { "enum": ["level0", "level1", "level2"] },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "maxWidth": { "type": "integer", "minimum": 1 },
    "maxHeight": { "type": "integer", "minimum": 1 },
    "maxArea": { "type": "integer", "minimum": 1 },
    "tiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["width", "scaleFactors"],
        "properties": {
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "scaleFactors": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "integer", "minimum": 1 }
          }
        },
        "additionalProperties": true
      }
    },
    "sizes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["width", "height"],
        "properties": {
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": true
      }
    },
    "extraFeatures": {
      "type": "array",
      "items": { "type": "string" }
    },
    "extraFormats": {
      "type": "array",
      "items": { "type": "string" }
    },
    "extraQualities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "service": {
      "type": "array",
      "items": { "$ref": "#/$defs/genericService" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "genericService": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "format": "uri" },
        "type": { "type": "string" },
        "profile": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
